[run]
source = .
omit =
    */migrations/*
    */tests/*
    manage.py
    order_engine/proto/*
    conftest.py
    .venv/*
    build/*
    dist/*
    .tox/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
